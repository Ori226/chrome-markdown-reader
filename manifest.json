{
  "manifest_version": 3,
  "name": "GitHub Markdown Reader",
  "version": "1.0.1",
  "description": "Render Markdown files and raw text with authentic GitHub styling, alerts, syntax highlighting, math, and outline.",
  "icons": {
    "16": "dist/assets/icon16.png",
    "32": "dist/assets/icon32.png",
    "48": "dist/assets/icon48.png",
    "128": "dist/assets/icon128.png"
  },
  "action": {
    "default_title": "GitHub Markdown Reader",
    "default_popup": "dist/popup.html",
    "default_icon": {
      "16": "dist/assets/icon16.png",
      "32": "dist/assets/icon32.png",
      "48": "dist/assets/icon48.png",
      "128": "dist/assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*",
        "https://raw.githubusercontent.com/*",
        "https://gist.githubusercontent.com/*",
        "https://gitlab.com/*/raw/*",
        "https://bitbucket.org/*/raw/*"
      ],
      "js": ["dist/content.js"],
      "css": ["dist/content.css"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "storage",
    "contextMenus",
    "scripting",
    "activeTab"
  ],
  "commands": {
    "toggle_markdown": {
      "suggested_key": {
        "default": "Alt+M",
        "mac": "Alt+M"
      },
      "description": "Toggle GitHub Markdown rendering"
    }
  }
}
